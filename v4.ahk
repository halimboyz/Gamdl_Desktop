#Requires AutoHotkey v2.0
#SingleInstance Force

; ======================================================================
;   GAMDL v4  -  Apple Music style downloader   (AutoHotkey v2)
;   needs Python 3.10+ + gamdl 4.x (pip install "gamdl[widevine]") and the
;   WebView2 runtime.  Full-song playback also needs mpv + yt-dlp (checked the same way).
;   At startup they are checked; if anything is missing the script asks
;   first, then downloads and installs it automatically.
;
;   The window is a small embedded browser (Microsoft Edge WebView2)
;   that shows the interface.  This script
;   is the engine behind it: queue, parallel downloads, album -> track
;   splitting, history, favorites and settings.
;
;   files next to the script:  gamdl_settings.ini  gamdl_history.tsv
;                              gamdl_favs.tsv      gamdl_error.log
;   (optional) gamdl_ui.html  - if present it is used instead of the
;                               built-in interface (for tweaking)
;
;  OFFICALLY MADE BY HLIM - gamdl is installed automatically if missing
;
;  gamdl 4 notes:  downloads now run as  "gamdl rip <url>",  and gamdl keeps its
;  sign-in (cookies / Wrapper / token) in ~/.gamdl/config.yml.  If that file is
;  missing the script opens "gamdl auth" once in a visible console window.
; ======================================================================


; ----------------------------------------------------------------------
;   settings + state
; ----------------------------------------------------------------------
iniFile  := A_ScriptDir . "\gamdl_settings.ini"
histFile := A_ScriptDir . "\gamdl_history.tsv"
favFile  := A_ScriptDir . "\gamdl_favs.tsv"
shFile   := A_ScriptDir . "\gamdl_searches.txt"
logFile  := A_ScriptDir . "\gamdl_error.log"
tmpDir   := A_Temp . "\gamdl_tmp"       ; gamdl's gamdl_xxxx work folders go here, out of sight

cfg := {}
cfg.country := IniRead(iniFile, "settings", "country", "us")    ; storefront for searching
cfg.outdir  := IniRead(iniFile, "settings", "outdir", "")       ; blank = gamdl default
cfg.cookies := IniRead(iniFile, "settings", "cookies", "")      ; blank = gamdl default
cfg.extra   := IniRead(iniFile, "settings", "extra", "")        ; extra gamdl flags
cfg.notify  := (IniRead(iniFile, "settings", "notify", "1") = "1")
cfg.clean   := (IniRead(iniFile, "settings", "clean", "0") = "1")   ; explicit songs play their clean version
p0 := IniRead(iniFile, "settings", "parallel", "4")
cfg.parallel := IsInteger(p0) ? Min(8, Max(1, Integer(p0))) : 4
cfg.split   := (IniRead(iniFile, "settings", "split", "1") = "1")   ; albums -> separate tracks
v0 := IniRead(iniFile, "settings", "volume", "80")
cfg.volume  := IsInteger(v0) ? Min(100, Max(0, Integer(v0))) : 80   ; preview player volume

app := {}
app.queue  := []
app.hist   := []
app.favs   := []
app.sh     := []
app.httpq  := []
app.nextId := 1
app.run    := {on: false, stop: false, jobs: [], ok: 0, bad: 0, seq: 0}

pyExe    := ""      ; python.exe, resolved at startup
gamdlExe := ""      ; gamdl.exe, resolved at startup
mpvExe   := ""      ; mpv.exe, resolved at startup
ytdlpExe := ""      ; yt-dlp.exe, resolved at startup
aria2Exe := ""      ; aria2c.exe (optional), makes the next-song download faster
cacheDir := A_AppData . "\GAMDL_cache"      ; every song that played or was fetched ahead stays here, so playing it again starts at once
pf       := {cur: "", nxt: "", url: "", pid: 0, bad: Map()}      ; cur / nxt = songs waiting to be saved, url / pid = the one being saved now
mp       := {af: "", pid: 0, t0: 0, loading: false, pipe: "\\.\pipe\gamdl_mpv", flag: A_Temp . "\gamdl_mpv.ok", pos: A_Temp . "\gamdl_mpv.pos", lua: A_Temp . "\gamdl_mpv.lua"}   ; the mpv that plays a full song

; gamdl writes to a log file here, not a console: force UTF-8 so track names
; with non-latin characters cannot crash it with a cp1252 UnicodeEncodeError
EnvSet("PYTHONUTF8", "1")
EnvSet("PYTHONIOENCODING", "utf-8")


; ----------------------------------------------------------------------
;   first-run check:  python, gamdl and the WebView2 runtime
;   nothing is downloaded until the user says yes
; ----------------------------------------------------------------------
SetupPrereqs()
EnvSet("PATH", RegExReplace(ytdlpExe, "\\[^\\]+$") . ";" . EnvGet("LocalAppData") . "\gamdl_deno;" . EnvGet("PATH"))   ; mpv looks for yt-dlp on PATH, yt-dlp for deno (InstallDenoAsync unpacks it there)
EnsureGamdlAuth()
CheckOldFlags()
aria2Exe := FindAria2()
if aria2Exe = ""
    InstallAria2Async()          ; optional, so it downloads quietly in the background and never blocks the start
if ExeOnPath("deno.exe") = ""      ; yt-dlp needs a JavaScript runtime to see all of YouTube's audio formats, without one the best can be missing
    InstallDenoAsync()
try DirDelete(A_Temp . "\gamdl_next", 1)      ; the old, temporary cache
DirCreate(cacheDir)
loop files cacheDir . "\*.*"      ; a save cut short by the last exit leaves half a file
    if RegExMatch(A_LoopFileName, "i)\.(part|ytdl|aria2)$")
        try FileDelete(A_LoopFileFullPath)


; the installer only runs when something is missing
SetupPrereqs() {
    global pyExe, gamdlExe, mpvExe, ytdlpExe

    pyExe    := FindPython()
    gamdlExe := FindGamdl(pyExe)
    mpvExe   := FindMpv()
    ytdlpExe := FindYtdlp(pyExe)
    haveWV   := HasWebView2()

    missing := []
    if pyExe = ""
        missing.Push("Python")
    if gamdlExe = ""
        missing.Push("gamdl")
    if mpvExe = ""
        missing.Push("mpv")
    if ytdlpExe = ""
        missing.Push("yt-dlp")
    if !haveWV
        missing.Push("Microsoft Edge WebView2")

    if missing.Length = 0
        return

    list := ""
    for m in missing
        list .= "    - " . m . "`n"
    msg := "GAMDL needs a few things that are not installed yet:`n`n" . list
        . "`nDo you want me to download and install them now?`n"
        . "This needs an internet connection and can take a few minutes."
    if MsgBox(msg, "GAMDL - first-time setup", "YesNo Icon? Default2") != "Yes"
        ExitApp()

    prog := Gui("+AlwaysOnTop -MinimizeBox", "GAMDL - setup")
    prog.BackColor := "1C1C1C"
    prog.SetFont("s10 cDCDCDC", "Segoe UI")
    status := prog.Add("Text", "w440 h70", "Preparing...")
    prog.Show("w470 h100 Center")

    for m in missing {
        if m = "Python" {
            status.Text := "Installing Python 3...`nThis can take a few minutes."
            if !InstallPython()
                SetupFail(prog, "Python could not be installed automatically.`n`nPlease install it from https://www.python.org/downloads/ and start GAMDL again.")
            pyExe := FindPython()
        } else if m = "gamdl" {
            status.Text := "Installing gamdl...`nThis can take a few minutes."
            if !InstallGamdl(pyExe)
                SetupFail(prog, "gamdl could not be installed automatically.`n`nOpen Command Prompt and run:  pip install gamdl")
            gamdlExe := FindGamdl(pyExe)
        } else if m = "mpv" {
            status.Text := "Installing mpv...`nThis can take a few minutes."
            if !InstallMpv()
                SetupFail(prog, "mpv could not be installed automatically.`n`nPlease install it from https://mpv.io/installation/ and start GAMDL again.")
            mpvExe := FindMpv()
        } else if m = "yt-dlp" {
            status.Text := "Installing yt-dlp...`nThis can take a few minutes."
            if !InstallYtdlp(pyExe)
                SetupFail(prog, "yt-dlp could not be installed automatically.`n`nOpen Command Prompt and run:  pip install yt-dlp")
            ytdlpExe := FindYtdlp(pyExe)
        } else {
            status.Text := "Installing Microsoft Edge WebView2...`nThis can take a few minutes."
            if !InstallWebView2()
                SetupFail(prog, "Microsoft Edge WebView2 could not be installed automatically.`n`nDownload it from https://developer.microsoft.com/microsoft-edge/webview2/")
        }
    }

    prog.Destroy()
    MsgBox("All set - GAMDL will start now.", "GAMDL - setup", "Iconi")
}

SetupFail(prog, msg) {
    prog.Destroy()
    MsgBox(msg, "GAMDL - setup", "Icon!")
    ExitApp()
}

; gamdl 4 stores how you are signed in (cookies / Wrapper / token) in
; ~/.gamdl/config.yml.  Without it the first download starts a full-screen
; wizard that cannot be answered from a hidden window, so run it once here,
; in a normal console window.
EnsureGamdlAuth() {
    if gamdlExe = ""
        return
    if FileExist(EnvGet("USERPROFILE") . "\.gamdl\config.yml")
        return
    msg := "gamdl 4 needs a one-time sign-in before it can download.`n`n"
        . "A console window will open now. Follow the steps in it (choose cookies, Wrapper or a token), "
        . "and when it says it is finished, close it.`n`n"
        . "You can run this again any time with:  gamdl auth`n`n"
        . "Open it now?"
    if MsgBox(msg, "GAMDL - sign in", "YesNo Iconi") != "Yes"
        return
    try RunWait(A_ComSpec . ' /c ""' . gamdlExe . '" auth"', A_WorkingDir)
}

; flags that gamdl 3 accepted but gamdl 4 rejects - if one of them is sitting in
; the "Extra gamdl flags" setting, every download would fail
CheckOldFlags() {
    if Trim(cfg.extra) = ""
        return
    gone := Map()
    gone["--use-wrapper"]                := "run  gamdl auth  instead"
    gone["--wvd-path"]                   := "--device-path"
    gone["--prd-path"]                   := "--device-path"
    gone["--output-path"]                := "--output-dir (or the Download folder setting)"
    gone["--config-path"]                := "--config"
    gone["--no-config-file"]             := "--no-config"
    gone["--song-codec-priority"]        := "see  gamdl rip --help  (the default is now aac)"
    gone["--music-video-codec-priority"] := "see  gamdl rip --help"
    gone["--synced-lyrics-format"]       := "--lyrics-file-format and --embedded-lyrics-format"
    gone["--no-synced-lyrics"]           := "--no-lyrics-file"
    gone["--synced-lyrics-only"]         := "no equivalent any more"
    gone["--music-video-resolution"]     := "--max-height"
    gone["--music-video-remux-format"]   := "--music-video-container"
    gone["--download-mode"]              := "removed"
    gone["--read-urls-as-txt"]           := "removed"
    bad := ""
    for flag, hint in gone
        if InStr(cfg.extra, flag)
            bad .= "    " . flag . "   ->   " . hint . "`n"
    if bad = ""
        return
    MsgBox("The 'Extra gamdl flags' setting still has options that gamdl 4 no longer has:`n`n" . bad
        . "`nOpen Settings and change or clear them, otherwise downloads will fail.", "GAMDL", "Icon!")
}


; ----------------------------------------------------------------------
;   prerequisite detection
; ----------------------------------------------------------------------

; full path of python.exe, or "" when it is not installed
FindPython() {
    ; 1) registry entries written by the python.org installer (also used by winget)
    for hive in ["HKCU\Software\Python\PythonCore", "HKLM\Software\Python\PythonCore", "HKLM\Software\WOW6432Node\Python\PythonCore"] {
        for ver in ["3.14", "3.13", "3.12", "3.11", "3.10"] {      ; gamdl 4 needs 3.10 or newer
            dir := ""
            try dir := RTrim(RegRead(hive . "\" . ver . "\InstallPath", ""), "\")
            if dir != "" && FileExist(dir . "\python.exe")
                return dir . "\python.exe"
        }
    }
    ; 2) python.exe on PATH (the Microsoft Store alias is not real python)
    p := ExeOnPath("python.exe")
    if p != "" && !InStr(p, "\WindowsApps\")
        return p
    ; 3) the usual install folders (highest version wins)
    best := ""
    bestVer := 0
    for root in [EnvGet("LocalAppData") . "\Programs\Python", EnvGet("ProgramFiles") . "\Python", EnvGet("ProgramFiles(x86)") . "\Python"] {
        if root = ""
            continue
        try {
            loop files root . "\Python3*\python.exe", "F" {
                if RegExMatch(A_LoopFileDir, "Python3(\d+)$", &m) && Integer(m[1]) >= 10 && Integer(m[1]) > bestVer {
                    bestVer := Integer(m[1])
                    best := A_LoopFileFullPath
                }
            }
        }
    }
    return best
}

; full path of gamdl.exe, or "" when it is not installed
FindGamdl(py := "", exe := "gamdl.exe") {
    ; 1) the Scripts folder next to python
    if py != "" {
        dir := RTrim(RegExReplace(py, "\\[^\\]+$"), "\")
        for cand in [dir . "\Scripts\" . exe, dir . "\" . exe]
            if FileExist(cand)
                return cand
    }
    ; 2) gamdl.exe on PATH
    p := ExeOnPath(exe)
    if p != ""
        return p
    ; 3) the usual Scripts folders (highest version wins)
    best := ""
    bestVer := 0
    for root in [EnvGet("LocalAppData") . "\Programs\Python", EnvGet("AppData") . "\Python", EnvGet("ProgramFiles") . "\Python"] {
        if root = ""
            continue
        try {
            loop files root . "\Python3*\Scripts\" . exe, "F" {
                if RegExMatch(A_LoopFileDir, "Python3(\d+)\\Scripts$", &m) && Integer(m[1]) > bestVer {
                    bestVer := Integer(m[1])
                    best := A_LoopFileFullPath
                }
            }
        }
    }
    return best
}

FindYtdlp(py := "") {
    if FileExist(A_ScriptDir . "\yt-dlp.exe")      ; the official standalone build starts faster than the pip one
        return A_ScriptDir . "\yt-dlp.exe"
    return FindGamdl(py, "yt-dlp.exe")
}

; full path of mpv.exe, or "" when it is not installed
FindMpv() {
    p := ExeOnPath("mpv.exe")
    if p != ""
        return p
    loop files EnvGet("LocalAppData") . "\gamdl_mpv\mpv.exe", "R"      ; where InstallMpv unpacks it
        return A_LoopFileFullPath
    return ""
}

; full path of aria2c.exe, or "" (optional: makes the next-song download faster)
FindAria2() {
    p := ExeOnPath("aria2c.exe")
    if p != ""
        return p
    loop files EnvGet("LocalAppData") . "\gamdl_aria2\aria2c.exe", "R"
        return A_LoopFileFullPath
    return ""
}

; full path of an executable on PATH, or ""
ExeOnPath(name) {
    for dir in StrSplit(EnvGet("PATH"), ";") {
        dir := Trim(dir, ' "')
        if dir = ""
            continue
        p := RTrim(dir, "\") . "\" . name
        if FileExist(p)
            return p
    }
    return ""
}

; is the Edge WebView2 runtime installed?  (same folders the WebView2 class uses)
HasWebView2() {
    for root in [EnvGet("ProgramFiles(x86)"), A_AppData . "\..\Local"] {
        if root = ""
            continue
        try {
            loop files root . "\Microsoft\EdgeWebView\Application\*", "D"
                return true
        }
    }
    return false
}


; ----------------------------------------------------------------------
;   prerequisite installation  (only called after the user said yes)
; ----------------------------------------------------------------------

InstallPython() {
    ; winget is the cleanest way on Windows 10/11
    winget := ExeOnPath("winget.exe")
    if winget != "" {
        RunWait(A_ComSpec . ' /c ""' . winget . '" install -e --id Python.Python.3.12 --silent --accept-package-agreements --accept-source-agreements"', , "Hide")
        if FindPython() != ""
            return true
    }
    ; fallback: the official python.org installer (per user, includes pip)
    url := "https://www.python.org/ftp/python/3.12.10/python-3.12.10-amd64.exe"
    exe := A_Temp . "\gamdl_python_setup.exe"
    try FileDelete(exe)
    try Download(url, exe)
    if !FileExist(exe)
        return false
    RunWait('"' . exe . '" /quiet InstallAllUsers=0 PrependPath=1 Include_pip=1 Include_launcher=1', , "Hide")
    try FileDelete(exe)
    return FindPython() != ""
}

InstallGamdl(py) {
    if py = ""
        return false
    ; pip should be there, but make sure
    if RunWait(A_ComSpec . ' /c ""' . py . '" -m pip --version >nul 2>nul"', , "Hide")
        RunWait(A_ComSpec . ' /c ""' . py . '" -m ensurepip --upgrade >nul 2>nul"', , "Hide")
    ; gamdl 4 ships its Widevine support as an optional extra
    RunWait(A_ComSpec . ' /c ""' . py . '" -m pip install --upgrade --disable-pip-version-check gamdl[widevine]"', , "Hide")
    return FindGamdl(py) != ""
}

InstallMpv() {
    ps := A_Temp . "\gamdl_mpv_setup.ps1"
    try FileDelete(ps)
    FileAppend("
    (LTrim
    $ErrorActionPreference = 'Stop'
    $ProgressPreference = 'SilentlyContinue'
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    $d = Join-Path $env:LOCALAPPDATA 'gamdl_mpv'
    New-Item -ItemType Directory -Force $d | Out-Null
    $rel = Invoke-RestMethod 'https://api.github.com/repos/shinchiro/mpv-winbuild-cmake/releases/latest'
    $u = ($rel.assets | Where-Object { $_.name -match '^mpv-x86_64-\d+-git-.*\.7z$' } | Select-Object -First 1).browser_download_url
    $z = Join-Path $d 'mpv.7z'
    $x = Join-Path $d '7zr.exe'
    Invoke-WebRequest $u -OutFile $z
    Invoke-WebRequest 'https://www.7-zip.org/a/7zr.exe' -OutFile $x
    & $x x $z ('-o' + $d) -y | Out-Null
    Remove-Item $z, $x
    )", ps)
    RunWait('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' . ps . '"', , "Hide")
    try FileDelete(ps)
    return FindMpv() != ""
}

; aria2c is optional, so it is fetched in the background: no prompt, no waiting, a failure is simply ignored
InstallAria2Async() {
    ps := A_Temp . "\gamdl_aria2_setup.ps1"
    try FileDelete(ps)
    FileAppend("
    (LTrim
    $ErrorActionPreference = 'Stop'
    $ProgressPreference = 'SilentlyContinue'
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    $d = Join-Path $env:LOCALAPPDATA 'gamdl_aria2'
    New-Item -ItemType Directory -Force $d | Out-Null
    $rel = Invoke-RestMethod 'https://api.github.com/repos/aria2/aria2/releases/latest'
    $u = ($rel.assets | Where-Object { $_.name -match '^aria2-.*-win-64bit-build\d+\.zip$' } | Select-Object -First 1).browser_download_url
    $z = Join-Path $d 'aria2.zip'
    Invoke-WebRequest $u -OutFile $z
    Expand-Archive $z -DestinationPath $d -Force
    Remove-Item $z
    Remove-Item $PSCommandPath
    )", ps)
    try Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' . ps . '"', , "Hide")
}

; deno, same quiet background download as aria2c; when it lands the cached songs are cleared, they were saved without it
; shortcut: always the latest Deno and a retry on every start if the download fails, pin a version if a new Deno ever breaks yt-dlp
InstallDenoAsync() {
    ps := A_Temp . "\gamdl_deno_setup.ps1"
    try FileDelete(ps)
    FileAppend("
    (LTrim
    $ErrorActionPreference = 'Stop'
    $ProgressPreference = 'SilentlyContinue'
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    $d = Join-Path $env:LOCALAPPDATA 'gamdl_deno'
    New-Item -ItemType Directory -Force $d | Out-Null
    $z = Join-Path $d 'deno.zip'
    Invoke-WebRequest 'https://github.com/denoland/deno/releases/latest/download/deno-x86_64-pc-windows-msvc.zip' -OutFile $z
    Expand-Archive $z -DestinationPath $d -Force
    Remove-Item $z
    Remove-Item (Join-Path $env:APPDATA 'GAMDL_cache\*') -Force -ErrorAction SilentlyContinue
    Remove-Item $PSCommandPath
    )", ps)
    try Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' . ps . '"', , "Hide")
}

InstallYtdlp(py) {
    if py = ""
        return false
    RunWait(A_ComSpec . ' /c ""' . py . '" -m pip install --upgrade --disable-pip-version-check yt-dlp[default]"', , "Hide")
    return FindYtdlp(py) != ""
}

InstallWebView2() {
    ; Microsoft's Evergreen Bootstrapper
    url := "https://go.microsoft.com/fwlink/p/?LinkId=2124703"
    exe := A_Temp . "\gamdl_webview2_setup.exe"
    try FileDelete(exe)
    try Download(url, exe)
    if !FileExist(exe)
        return false
    RunWait('"' . exe . '" /silent /install', , "Hide")
    try FileDelete(exe)
    return HasWebView2()
}


; ----------------------------------------------------------------------
;   window with the embedded browser (Microsoft Edge WebView2)
; ----------------------------------------------------------------------
g := Gui("+Resize -Caption +MinSize900x600", "GAMDL")
g.BackColor := "1C1C1C"
g.MarginX := 0
g.MarginY := 0
g.Opt("+OwnDialogs")
g.OnEvent("Close", (*) => ExitApp())
g.OnEvent("Size", OnSize)
OnMessage(0x83, NcCalc)   ; WM_NCCALCSIZE
g.Show("w1213 h899")

; create the WebView2 control
wvc := 0
wv  := 0
try {
    wvc := WebView2.CreateControllerAsync(g.Hwnd, {AdditionalBrowserArguments: "--autoplay-policy=no-user-gesture-required --ignore-gpu-blocklist --enable-gpu-rasterization"}, A_AppData . "\GAMDL_WebView2").await2(15000)
    wv  := wvc.CoreWebView2
    try wv.Settings.IsNonClientRegionSupportEnabled := true   ; the page's drag strip (-webkit-app-region) moves the window
} catch as e {
    MsgBox("The embedded browser (WebView2) could not start.`n`n" . e.Message, "GAMDL", "Icon!")
    ExitApp()
}
uiHtml := LoadUiHtml()
if !InStr(uiHtml, 'id="tbar"')   ; an older interface has no title bar of its own, so keep the Windows one
    g.Opt("+Caption")
wv.NavigateToString(uiHtml)

uiReady := false
t0 := A_TickCount
while !uiReady && A_TickCount - t0 < 15000 {
    try {
        raw := wv.ExecuteScriptAsync("window.__ready").await2(1000)
        if Trim(raw) = "true"
            uiReady := true
    } catch {
    }
    if !uiReady
        Sleep(50)
}
if !uiReady {
    MsgBox("The embedded browser could not start the interface.`n`nIf this keeps happening, delete gamdl_ui.html (if you have one) and try again.", "GAMDL", "Icon!")
    ExitApp()
}

OnExit(CleanUp)
CleanTemp()
LoadHistory()
LoadFavs()
LoadSearches()
SetTimer(PollUI, 50)


; ======================================================================
;   browser plumbing
; ======================================================================

; (IE11 emulation no longer needed with WebView2)

; the interface (base64 inside this file, or gamdl_ui.html next to it)
LoadUiHtml() {
    override := A_ScriptDir . "\gamdl_ui.html"
    if FileExist(override)
        return FileRead(override, "UTF-8")
    b64 := UiData()
    size := 0
    DllCall("crypt32\CryptStringToBinaryW", "Str", b64, "UInt", 0, "UInt", 1, "Ptr", 0, "UInt*", &size, "Ptr", 0, "Ptr", 0)
    buf := Buffer(size)
    DllCall("crypt32\CryptStringToBinaryW", "Str", b64, "UInt", 0, "UInt", 1, "Ptr", buf, "UInt*", &size, "Ptr", 0, "Ptr", 0)
    return StrGet(buf, size, "UTF-8")
}

; drop the top frame strip Windows paints on a captionless window (it shows as a light line);
; left, right and bottom stay, so those edges still resize
NcCalc(wParam, lParam, msg, hwnd) {
    if !wParam || hwnd != g.Hwnd || DllCall("IsZoomed", "Ptr", hwnd) || (WinGetStyle(hwnd) & 0xC00000) = 0xC00000
        return
    top := NumGet(lParam, 4, "Int")
    DllCall("DefWindowProc", "Ptr", hwnd, "UInt", msg, "Ptr", wParam, "Ptr", lParam, "Ptr")
    NumPut("Int", top, lParam, 4)
    return 0
}

OnSize(guiObj, minMax, w, h) {
    if minMax = -1
        return
    try wvc.Fill()
}

; smooth maximize / restore: Windows does not animate a captionless window, so tween the rectangle
; ourselves (ease-in-out, 280 ms), then switch to the real state while already in place
; shortcut: no animation when the window was maximized another way (double-click, Win+Up), read GetWindowPlacement if that matters
AnimMax() {
    static rest := "", busy := false
    if busy
        return
    busy := true
    try {
        full := FullRect()
        if WinGetMinMax(g.Hwnd) = 1 {
            if !IsObject(rest) {
                g.Restore()
                return
            }
            g.Restore()
            Tween(full, rest)
        } else {
            WinGetPos(&x, &y, &w, &h, g.Hwnd)
            rest := [x, y, w, h]
            Tween(rest, full)
            g.Maximize()
        }
    } finally
        busy := false
}

; where a maximized window sits: the work area of its monitor, plus the invisible side and bottom frame
; (the top strip is dropped by NcCalc), so the client area is identical before and after Maximize()
FullRect() {
    WinGetPos(&x, &y, &w, &h, g.Hwnd)
    cx := x + w // 2, cy := y + h // 2
    MonitorGetWorkArea(MonitorGetPrimary(), &l, &t, &r, &b)
    loop MonitorGetCount() {
        MonitorGetWorkArea(A_Index, &ml, &mt, &mr, &mb)
        if cx >= ml && cx < mr && cy >= mt && cy < mb {
            l := ml, t := mt, r := mr, b := mb
            break
        }
    }
    f := SysGet(32) + SysGet(92)   ; SM_CXSIZEFRAME + SM_CXPADDEDBORDER
    return [l - f, t, r - l + 2 * f, b - t + f]
}

Tween(a, b, ms := 280) {
    t0 := A_TickCount
    loop {
        p := Min(1, (A_TickCount - t0) / ms)
        e := p < 0.5 ? 4 * p ** 3 : 1 - (-2 * p + 2) ** 3 / 2
        DllCall("SetWindowPos", "Ptr", g.Hwnd, "Ptr", 0
            , "Int", Round(a[1] + (b[1] - a[1]) * e), "Int", Round(a[2] + (b[2] - a[2]) * e)
            , "Int", Round(a[3] + (b[3] - a[3]) * e), "Int", Round(a[4] + (b[4] - a[4]) * e)
            , "UInt", 0x14)   ; SWP_NOZORDER | SWP_NOACTIVATE
        if p = 1
            break
        Sleep(1)
    }
}

LogErr(e) {
    try FileAppend(FormatTime(, "yyyy-MM-dd HH:mm:ss") . "  " . e.Message . "  (line " . e.Line . ", " . e.What . ")`n", logFile, "UTF-8")
}

; ask the page for waiting messages and run them
PollUI() {
    static busy := false
    if busy
        return
    busy := true
    try {
        s := ""
        try {
            raw := wv.ExecuteScriptAsync("window.__drain()").await2(1000)
            s := JsonUnquote(raw)
        }
        if s != "" {
            for line in StrSplit(s, "`n") {
                if line = ""
                    continue
                try {
                    Handle(line)
                } catch as e {
                    LogErr(e)
                }
            }
        }
    } finally {
        busy := false
    }
}

; one message from the page:  cmd|arg|arg   (args are percent-encoded UTF-8)
Handle(line) {
    parts := StrSplit(line, "|")
    cmd := parts[1]
    args := []
    n := parts.Length - 1
    Loop n
        args.Push(UrlDec(parts[A_Index + 1]))

    if cmd = "ready" {
        PushCfg()
        PushQueueNow()
        PushFavs()
        PushSearches()
        PushProg()
    } else if cmd = "http" {
        HttpStart(Arg(args, 1), Arg(args, 2))
    } else if cmd = "add" {
        QueueAdd(Arg(args, 1), Arg(args, 2), Arg(args, 3), Arg(args, 4), Arg(args, 5))
    } else if cmd = "addlink" {
        UiPush("toast", AddLink(Arg(args, 1)))
    } else if cmd = "start" {
        StartQueue()
    } else if cmd = "stop" {
        StopQueue()
    } else if cmd = "retry" {
        RetryFailed()
    } else if cmd = "clearfin" {
        ClearFinished()
    } else if cmd = "rm" {
        RemoveItem(Arg(args, 1))
    } else if cmd = "set" {
        DoSet(Arg(args, 1), Arg(args, 2))
    } else if cmd = "cfgsave" {
        DoCfgSave(args)
    } else if cmd = "pickdir" {
        d := DirSelect(, 3, "Choose where your music should be saved")
        if d != ""
            UiPush("picked", "dir|" . d)
    } else if cmd = "pickfile" {
        f := FileSelect(1, , "Choose your cookies.txt", "Cookies (*.txt)")
        if f != ""
            UiPush("picked", "file|" . f)
    } else if cmd = "openfolder" {
        OpenFolder()
    } else if cmd = "hist" {
        PushHist()
    } else if cmd = "histclear" {
        app.hist := []
        try FileDelete(histFile)
        PushHist()
    } else if cmd = "favs" {
        PushFavs()
    } else if cmd = "fav_set" {
        FavSet(Arg(args, 1), Arg(args, 2), Arg(args, 3), Arg(args, 4))
    } else if cmd = "fav_del" {
        FavDel(Arg(args, 1))
    } else if cmd = "sh_add" {
        SearchAdd(Arg(args, 1))
    } else if cmd = "sh_del" {
        SearchDel(Arg(args, 1))
    } else if cmd = "sh_clear" {
        app.sh := []
        try FileDelete(shFile)
        PushSearches()
    } else if cmd = "mpv" {
        MpvPlay(Arg(args, 1), Arg(args, 2))
    } else if cmd = "mpvpre" {
        MpvPre(Arg(args, 1))
    } else if cmd = "mpvpause" {
        MpvCmd('["set_property","pause",' . (Arg(args, 1) = "1" ? "true" : "false") . ']')
    } else if cmd = "mpvvol" && IsInteger(Arg(args, 1)) {
        MpvCmd('["set_property","volume",' . Arg(args, 1) . ']')
    } else if cmd = "mpvseek" && IsNumber(Arg(args, 1)) {
        MpvCmd('["seek",' . Arg(args, 1) . ',"absolute"]')
    } else if cmd = "mpveq" {
        MpvEq(Arg(args, 1))
    } else if cmd = "mpvstop" {
        MpvStop()
    } else if cmd = "wmin" {
        g.Minimize()
    } else if cmd = "wmax" {
        AnimMax()
    } else if cmd = "wclose" {
        ExitApp()
    } else if cmd = "wdrag" {   ; fallback when the drag strip is not handled natively
        DllCall("ReleaseCapture")
        PostMessage(0xA1, 2, 0, , "ahk_id " . g.Hwnd)
    } else if cmd = "clip" {
        UiPush("clip", A_Clipboard)
    }
}

Arg(a, i) {
    return a.Has(i) ? a[i] : ""
}

; percent-decoding of UTF-8 text coming from encodeURIComponent()
UrlDec(str) {
    if !InStr(str, "%")
        return str
    n := StrLen(str)
    buf := Buffer(n + 1, 0)
    out := 0
    i := 1
    while i <= n {
        ch := SubStr(str, i, 1)
        if ch = "%" && i + 2 <= n {
            hx := SubStr(str, i + 1, 2)
            if RegExMatch(hx, "^[0-9A-Fa-f]{2}$") {
                NumPut("UChar", Integer("0x" . hx), buf, out)
                out += 1
                i += 3
                continue
            }
        }
        NumPut("UChar", Ord(ch) & 0xFF, buf, out)
        out += 1
        i += 1
    }
    return StrGet(buf, out, "UTF-8")
}

; send something to the page
UiPush(kind, payload) {
    try wv.ExecuteScriptAsync("window.onAhk(" . JsStr(kind) . "," . JsStr(payload) . ")")
}

; escape a string into a JavaScript string literal
JsStr(s) {
    s := StrReplace(s, "\", "\\")
    s := StrReplace(s, '"', '\"')
    s := StrReplace(s, "`r", "\r")
    s := StrReplace(s, "`n", "\n")
    s := StrReplace(s, "`t", "\t")
    return '"' . s . '"'
}

; unquote/unescape a value returned by ExecuteScript (JSON string or primitive)
JsonUnquote(s) {
    s := Trim(s)
    if s = ""
        return ""
    if SubStr(s, 1, 1) = '"' && SubStr(s, StrLen(s)) = '"' && StrLen(s) >= 2
        s := SubStr(s, 2, StrLen(s) - 2)
    out := ""
    i := 1
    n := StrLen(s)
    while i <= n {
        c := SubStr(s, i, 1)
        if c = "\" && i < n {
            e := SubStr(s, i + 1, 1)
            if e = "n" {
                out .= "`n"
                i += 2
                continue
            } else if e = "r" {
                out .= "`r"
                i += 2
                continue
            } else if e = "t" {
                out .= "`t"
                i += 2
                continue
            } else if e = '"' {
                out .= '"'
                i += 2
                continue
            } else if e = "\" {
                out .= "\"
                i += 2
                continue
            } else if e = "/" {
                out .= "/"
                i += 2
                continue
            } else if e = "u" && i + 5 <= n {
                hx := SubStr(s, i + 2, 4)
                if RegExMatch(hx, "^[0-9A-Fa-f]{4}$") {
                    out .= Chr(Integer("0x" . hx))
                    i += 6
                    continue
                }
            }
        }
        out .= c
        i += 1
    }
    return out
}

; tiny JSON writer (Map / Array / number / string)
Json(v) {
    if v is Map {
        s := "{"
        first := true
        for k, x in v {
            s .= (first ? "" : ",") . '"' . JEsc(String(k)) . '":' . Json(x)
            first := false
        }
        return s . "}"
    }
    if v is Array {
        s := "["
        for i, x in v
            s .= (i > 1 ? "," : "") . Json(x)
        return s . "]"
    }
    if v is Number
        return String(v)
    return '"' . JEsc(String(v)) . '"'
}

JEsc(s) {
    s := StrReplace(s, "\", "\\")
    s := StrReplace(s, '"', '\"')
    s := StrReplace(s, "`r", "\r")
    s := StrReplace(s, "`n", "\n")
    s := StrReplace(s, "`t", "\t")
    return RegExReplace(s, "[\x00-\x1F]", "")
}


; ======================================================================
;   pushes to the page
; ======================================================================

PushCfg() {
    UiPush("cfg", Json(Map("country", cfg.country, "outdir", cfg.outdir, "cookies", cfg.cookies, "extra", cfg.extra, "parallel", cfg.parallel, "split", cfg.split ? 1 : 0, "notify", cfg.notify ? 1 : 0, "clean", cfg.clean ? 1 : 0, "volume", cfg.volume)))
}

; number of finished tracks / total tracks of a split album
ItemCounts(q) {
    done := 0
    total := 0
    if q.Has("subs") {
        total := q["subs"].Length
        for x in q["subs"]
            if x["status"] = "done"
                done += 1
    }
    return [done, total]
}

ItemProgress(q) {
    if !q.Has("subs")
        return q["pct"]
    sum := 0
    for x in q["subs"] {
        if x["status"] = "done"
            sum += 100
        else if x["status"] = "downloading"
            sum += x["pct"]
    }
    return sum // q["subs"].Length
}

PushQueueNow() {
    arr := []
    for q in app.queue {
        c := ItemCounts(q)
        pct := (q["status"] = "done") ? 100 : ItemProgress(q)
        arr.Push(Map("id", q["id"], "kind", q["kind"], "name", q["name"], "artist", q["artist"], "art", q["art"], "status", q["status"], "pct", pct, "done", c[1], "total", c[2]))
    }
    UiPush("queue", Json(arr))
}

PushProg() {
    active := []
    items := []
    seen := Map()
    for j in app.run.jobs {
        q := j["q"]
        sub := j["sub"]
        title := IsObject(sub) ? sub["name"] : q["name"]
        subtitle := IsObject(sub) ? q["name"] : q["artist"]
        active.Push(Map("id", q["id"], "title", title, "sub", subtitle, "pct", j["unit"]["pct"], "art", q["art"]))
        if !seen.Has(q["id"]) {
            seen[q["id"]] := true
            c := ItemCounts(q)
            items.Push(Map("id", q["id"], "pct", ItemProgress(q), "done", c[1], "total", c[2]))
        }
    }
    UiPush("prog", Json(Map("running", app.run.on ? 1 : 0, "stopping", (app.run.on && app.run.stop) ? 1 : 0, "pending", PendingCount(), "ok", app.run.ok, "bad", app.run.bad, "active", active, "items", items)))
}

PushHist() {
    arr := []
    i := app.hist.Length
    while i >= 1 && arr.Length < 500 {
        h := app.hist[i]
        arr.Push(Map("when", h["when"], "kind", h["kind"], "name", h["name"], "artist", h["artist"], "url", h["url"], "art", h["art"], "status", h["status"]))
        i -= 1
    }
    UiPush("hist", Json(arr))
}

PushFavs() {
    arr := []
    for f in app.favs
        arr.Push(Map("id", f["id"], "name", f["name"], "seen", f["seen"], "art", f["art"]))
    UiPush("favs", Json(arr))
}


; ======================================================================
;   settings
; ======================================================================

DoSet(key, val) {
    if key = "split" {
        cfg.split := (val = "1")
        IniWrite(cfg.split ? "1" : "0", iniFile, "settings", "split")
    } else if key = "notify" {
        cfg.notify := (val = "1")
        IniWrite(cfg.notify ? "1" : "0", iniFile, "settings", "notify")
    } else if key = "clean" {
        cfg.clean := (val = "1")
        IniWrite(cfg.clean ? "1" : "0", iniFile, "settings", "clean")
    } else if key = "volume" {
        if !IsInteger(val)
            return
        cfg.volume := Min(100, Max(0, Integer(val)))
        IniWrite(cfg.volume, iniFile, "settings", "volume")
        return                                   ; the page already knows the value
    } else if key = "parallel" {
        if !IsInteger(val)
            return
        cfg.parallel := Min(8, Max(1, Integer(val)))
        IniWrite(cfg.parallel, iniFile, "settings", "parallel")
        if app.run.on && !app.run.stop
            Pump()
    }
    PushCfg()
}

DoCfgSave(a) {
    c := StrLower(Trim(Arg(a, 1)))
    if !RegExMatch(c, "^[a-z]{2}$") {
        UiPush("toast", "Storefront must be a 2-letter country code, like us or my")
        return
    }
    pv := Trim(Arg(a, 5))
    if !IsInteger(pv) || pv < 1 || pv > 8 {
        UiPush("toast", "Parallel downloads must be a number from 1 to 8")
        return
    }
    cfg.country  := c
    cfg.outdir   := RTrim(Trim(Arg(a, 2), ' "'), "\")
    cfg.cookies  := Trim(Arg(a, 3), ' "')
    cfg.extra    := Trim(Arg(a, 4))
    cfg.parallel := Integer(pv)
    cfg.notify   := (Arg(a, 6) = "1")
    cfg.split    := (Arg(a, 7) = "1")
    IniWrite(cfg.country,  iniFile, "settings", "country")
    IniWrite(cfg.outdir,   iniFile, "settings", "outdir")
    IniWrite(cfg.cookies,  iniFile, "settings", "cookies")
    IniWrite(cfg.extra,    iniFile, "settings", "extra")
    IniWrite(cfg.parallel, iniFile, "settings", "parallel")
    IniWrite(cfg.notify ? "1" : "0", iniFile, "settings", "notify")
    IniWrite(cfg.split ? "1" : "0", iniFile, "settings", "split")
    PushCfg()
    UiPush("toast", "Settings saved")
    if app.run.on && !app.run.stop
        Pump()
}

; where downloads go.  gamdl 4 no longer has a built-in default - when no folder is
; configured it stops and asks, which would hang a hidden window - so we always pass
; one.  Blank setting = the "Apple Music" folder next to the script (the old default).
OutDir() {
    return cfg.outdir != "" ? cfg.outdir : A_WorkingDir . "\Apple Music"
}

OpenFolder() {
    dir := OutDir()
    if !DirExist(dir)
        dir := A_WorkingDir
    Run('explorer.exe "' . dir . '"')
}


; ======================================================================
;   queue  (parallel downloads, albums split into tracks)
; ======================================================================

; returns true if it was added (false = already waiting / downloading)
QueueAdd(kind, name, artist, url, art) {
    if url = ""
        return false
    for q in app.queue
        if q["url"] = url && (q["status"] = "waiting" || q["status"] = "downloading")
            return false
    id := app.nextId
    app.nextId += 1
    app.queue.Push(Map("id", id, "kind", kind, "name", name, "artist", artist, "url", url, "art", art, "status", "waiting", "pct", 0))
    RefreshQueue()
    return true
}

RefreshQueue() {
    SetTimer(PushQueueNow, -30)
}

PendingCount() {
    n := 0
    for q in app.queue
        if q["status"] = "waiting" || q["status"] = "downloading"
            n += 1
    return n
}

RemoveItem(id) {
    i := app.queue.Length
    while i >= 1 {
        q := app.queue[i]
        if q["id"] = id && q["status"] != "downloading" {
            app.queue.RemoveAt(i)
            break
        }
        i -= 1
    }
    RefreshQueue()
}

ClearFinished() {
    i := app.queue.Length
    while i >= 1 {
        s := app.queue[i]["status"]
        if s = "done" || s = "failed"
            app.queue.RemoveAt(i)
        i -= 1
    }
    RefreshQueue()
}

; failed items (and only their failed tracks) go back to waiting
RetryFailed() {
    for q in app.queue {
        if q["status"] != "failed"
            continue
        q["status"] := "waiting"
        if q.Has("subs")
            for x in q["subs"]
                if x["status"] = "failed"
                    x["status"] := "waiting"
    }
    RefreshQueue()
    if app.run.on {
        if !app.run.stop
            Pump()
    } else {
        StartQueue()
    }
}

NextWaiting() {
    for i, q in app.queue
        if q["status"] = "waiting"
            return i
    return 0
}

StartQueue() {
    if app.run.on {
        ; already running: just fill any free slots
        if !app.run.stop
            Pump()
        return
    }
    if NextWaiting() = 0
        RetryFailedQuiet()
    if NextWaiting() = 0 {
        UiPush("toast", "Nothing waiting in the queue")
        return
    }
    app.run.on := true
    app.run.stop := false
    app.run.ok := 0
    app.run.bad := 0
    app.run.jobs := []
    Pump()
}

; nothing waiting -> give the failed ones another go
RetryFailedQuiet() {
    for q in app.queue {
        if q["status"] != "failed"
            continue
        q["status"] := "waiting"
        if q.Has("subs")
            for x in q["subs"]
                if x["status"] = "failed"
                    x["status"] := "waiting"
    }
}

; start downloads until every parallel slot is busy (or nothing is waiting)
Pump() {
    if !app.run.on
        return
    if !app.run.stop {
        while app.run.jobs.Length < cfg.parallel && (t := NextTask())
            LaunchTask(t)
    }
    if app.run.jobs.Length = 0 {
        EndRun()
        return
    }
    RefreshQueue()
    PushProg()
    SetTimer(WatchRun, 300)
}

; ----------------------------------------------------------------------
;   work units: a "task" is either a whole queue item, or ONE TRACK of an
;   album that was split.  all tasks share the same parallel slots.
; ----------------------------------------------------------------------

; returns Map("q", item, "sub", track-or-"") or 0 when nothing is left to start
NextTask() {
    ; 1) keep feeding the album that is already in progress
    for q in app.queue {
        if q["status"] != "downloading" || !q.Has("subs")
            continue
        for x in q["subs"]
            if x["status"] = "waiting"
                return Map("q", q, "sub", x)
    }
    ; 2) otherwise start the next waiting item
    for q in app.queue {
        if q["status"] != "waiting"
            continue
        if cfg.split && q["kind"] = "album" && !q.Has("subs") && !q.Has("nosplit")
            ExpandAlbum(q)
        if q.Has("subs") {
            for x in q["subs"] {
                if x["status"] = "waiting" {
                    q["status"] := "downloading"
                    return Map("q", q, "sub", x)
                }
            }
            RefreshItemState(q)          ; nothing left in this one
            continue
        }
        q["status"] := "downloading"
        return Map("q", q, "sub", "")
    }
    return 0
}

; looks up the album's tracks and turns them into sub tasks
; (if that is not possible the album simply downloads as a whole)
ExpandAlbum(q) {
    id := ""
    if !RegExMatch(q["url"], "[?&]i=\d") && RegExMatch(q["url"], "/(\d{6,})(?:[/?#]|$)", &m)
        id := m[1]
    if id = "" {
        q["nosplit"] := true
        return
    }
    body := HttpGet("https://itunes.apple.com/lookup?id=" . id . "&entity=song&limit=200&country=" . cfg.country)
    tracks := ParseTracks(body)
    if tracks.Length < 2 {
        q["nosplit"] := true
        return
    }
    subs := []
    for t in tracks
        subs.Push(Map("name", t["name"], "url", t["url"], "status", "waiting", "pct", 0))
    q["subs"] := subs
}

LaunchTask(t) {
    q := t["q"]
    sub := t["sub"]
    unit := IsObject(sub) ? sub : q
    unit["status"] := "downloading"
    unit["pct"] := 0
    app.run.seq += 1
    lf := A_Temp . "\gamdl_log_" . app.run.seq . ".txt"
    try FileDelete(lf)
    try DirCreate(tmpDir)
    pid := 0
    try Run(BuildCmd(unit["url"], lf), A_WorkingDir, "Hide", &pid)
    if !pid {
        SettleUnit(q, sub, true)
        return
    }
    app.run.jobs.Push(Map("q", q, "sub", sub, "unit", unit, "pid", pid, "log", lf, "last", ""))
}

; a task finished (or could not start)
SettleUnit(q, sub, failed) {
    if IsObject(sub) {
        sub["status"] := failed ? "failed" : "done"
        if !failed
            sub["pct"] := 100
        RefreshItemState(q)
        return
    }
    q["status"] := failed ? "failed" : "done"
    if !failed
        q["pct"] := 100
    if failed
        app.run.bad += 1
    else
        app.run.ok += 1
    AddHistory(q, failed ? "failed" : "done")
}

; works out the state of a split album from its tracks
RefreshItemState(q) {
    nd := 0
    nw := 0
    nf := 0
    for x in q["subs"] {
        st := x["status"]
        if st = "downloading"
            nd += 1
        else if st = "waiting"
            nw += 1
        else if st = "failed"
            nf += 1
    }
    was := q["status"]
    if nd
        q["status"] := "downloading"
    else if nw
        q["status"] := (app.run.on && !app.run.stop) ? "downloading" : "waiting"
    else
        q["status"] := nf ? "failed" : "done"
    now := q["status"]
    if was = "downloading" && (now = "done" || now = "failed") {
        if now = "failed"
            app.run.bad += 1
        else
            app.run.ok += 1
        AddHistory(q, now)
    }
}

BuildCmd(url, lf) {
    gm := gamdlExe != "" ? gamdlExe : "gamdl"
    ; gamdl 4:  "gamdl rip <url>"  (the bare "gamdl <url>" form is gone)
    cmd := A_ComSpec . ' /v:on /c ""' . gm . '" rip "' . StrReplace(url, "!", "%21") . '"'
    cmd .= ' --output-dir "' . OutDir() . '"'                ; was -o / --output-path
    if cfg.cookies != ""
        cmd .= ' --cookies-path "' . cfg.cookies . '"'       ; was -c
    ; keep gamdl's temporary gamdl_xxxx folders out of the script folder
    ; (skipped if you set your own --temp-path in the extra flags)
    if !InStr(cfg.extra, "--temp-path")
        cmd .= ' --temp-path "' . tmpDir . '"'
    if cfg.extra != ""
        cmd .= " " . cfg.extra
    ; "< nul": if gamdl ever wants to ask something it fails at once instead of waiting forever
    cmd .= ' < nul > "' . lf . '" 2>&1 & echo ##EXIT=!errorlevel!>> "' . lf . '""'
    return cmd
}

WatchRun() {
    jobs := app.run.jobs
    finished := false
    i := jobs.Length
    while i >= 1 {
        j := jobs[i]
        unit := j["unit"]
        text := ""
        try text := FileRead(j["log"], "UTF-8")
        last := LastLine(text)
        j["last"] := last
        if RegExMatch(last, "(\d{1,3})\s*%", &p)
            unit["pct"] := Min(100, Integer(p[1]))
        if !ProcessExist(j["pid"]) {
            jobs.RemoveAt(i)
            FinishJob(j, text)
            try FileDelete(j["log"])
            finished := true
        }
        i -= 1
    }
    if finished {
        RefreshQueue()
        Pump()
        return
    }
    PushProg()
}

; one gamdl process has exited
FinishJob(j, text) {
    q := j["q"]
    sub := j["sub"]
    unit := IsObject(sub) ? sub : q
    if app.run.stop {
        unit["status"] := "waiting"       ; stopped by the user, can be resumed
        unit["pct"] := 0
        if IsObject(sub)
            RefreshItemState(q)
        return
    }
    code := -1
    if RegExMatch(text, "##EXIT=(\d+)", &m)
        code := Integer(m[1])
    failed := (code != 0) || RegExMatch(text, "Traceback|\bERROR\b|\bCRITICAL\b")
    if failed       ; keep what gamdl said, so a failure can be diagnosed from gamdl_error.log
        try FileAppend(FormatTime(, "yyyy-MM-dd HH:mm:ss") . "  FAILED  " . unit["url"] . "  (exit " . code . ")`n"
            . RTrim(text, "`r`n") . "`n`n", logFile, "UTF-8")
    SettleUnit(q, sub, failed)
}

EndRun() {
    app.run.on := false
    SetTimer(WatchRun, 0)
    CleanTemp()
    RefreshQueue()
    PushProg()
    UiPush("done", Json(Map("ok", app.run.ok, "bad", app.run.bad, "stopped", app.run.stop ? 1 : 0)))
    if app.run.stop || !cfg.notify
        return
    SoundBeep(900, 120)
    SoundBeep(1300, 160)
    TrayTip(app.run.ok . " downloaded, " . app.run.bad . " failed", "GAMDL - queue finished", "Iconi")
}

StopQueue() {
    if !app.run.on
        return
    app.run.stop := true
    KillRun()
    PushProg()
}

; kills every running gamdl process (and its children)
KillRun() {
    for j in app.run.jobs
        try RunWait(A_ComSpec . " /c taskkill /PID " . j["pid"] . " /T /F", , "Hide")
}

; removes leftover gamdl work folders (for example after STOP killed a download)
CleanTemp() {
    try DirDelete(tmpDir, true)
}

CleanUp(*) {
    MpvStop()
    KillRun()
    CleanTemp()
}


; ======================================================================
;   full songs: yt-dlp finds the song on YouTube Music, mpv plays it
; ======================================================================

; url = the YouTube Music search the page built; mpv plays the first song it lists
MpvPlay(url, vol) {
    MpvStop()
    if !RegExMatch(url, '^https://music\.youtube\.com/search\?q=[^"\s]+#songs$') {    ; trust boundary: goes into a command line
        MpvLog("refused url " . url)
        UiPush("mpv", "fail")
        return
    }
    f := PfReady(url)                          ; played or fetched before: it is on disk, so it starts without loading
    pf.cur := (f = "") ? url : ""              ; first time: mpv streams it now and PfPump saves it once it plays
    if f != ""
        try FileSetTime(, f)                   ; marks it as recently used, so PfTrim keeps it
    SetTimer(PfPump, 1000)
    ; a 1-line mpv script drops a flag file when audio really starts, so the page can show "loading" until then
    try FileDelete(mp.flag)
    mp.last := ""
    try FileDelete(mp.pos)
    try FileDelete(mp.lua)
    ; the same script also writes the real play position (10 times a second) so lyrics follow mpv's clock, not a guess
    ; it also quits mpv at the end of the song: the log showed mpv staying alive after end-file, so MpvWatch never saw the song end
    FileAppend('mp.register_event("playback-restart", function() io.open(os.getenv("GAMDL_FLAG"), "w"):close() end)`n'
        . 'local lg = os.getenv("GAMDL_LOG")`n'
        . 'local function L(t) local f = io.open(lg, "a"); if f then f:write(os.date("%H:%M:%S") .. "  mpv " .. t .. "\n"); f:close() end end`n'
        . 'mp.register_event("start-file", function() L("start-file") end)`n'
        . 'mp.register_event("playback-restart", function() local u = tostring(mp.get_property("stream-open-filename")); L("audio itag=" .. tostring(u:match("itag=(%d+)")) .. " codec=" .. tostring(mp.get_property("audio-codec-name")) .. " br=" .. tostring(mp.get_property("audio-bitrate"))) end)`n'
        . 'mp.register_event("file-loaded", function() L("file-loaded ao=" .. tostring(mp.get_property("current-ao")) .. " vol=" .. tostring(mp.get_property("volume")) .. " mute=" .. tostring(mp.get_property("mute")) .. " dur=" .. tostring(mp.get_property("duration")) .. " title=" .. tostring(mp.get_property("media-title")) .. " src=" .. tostring(mp.get_property("path"))) end)`n'
        . 'mp.register_event("end-file", function(e) L("end-file reason=" .. tostring(e.reason) .. " error=" .. tostring(e.error)); if e.reason == "eof" then mp.command("quit") end end)`n'
        . 'mp.register_event("shutdown", function() L("shutdown") end)`n'
        . 'mp.observe_property("pause", "bool", function(_, v) L("pause=" .. tostring(v)) end)`n'
        . 'mp.observe_property("core-idle", "bool", function(_, v) L("core-idle=" .. tostring(v)) end)`n'
        . 'local last = -1`n'
        . 'mp.observe_property("time-pos", "number", function(_, v) if v and math.floor(v * 10) ~= last then last = math.floor(v * 10); local f = io.open(os.getenv("GAMDL_POS"), "w"); if f then f:write(v); f:close() end end end)`n', mp.lua)
    EnvSet("GAMDL_FLAG", mp.flag)
    EnvSet("GAMDL_POS", mp.pos)
    EnvSet("GAMDL_LOG", A_ScriptDir . "\gamdl_mpv.log")
    cmd := '"' . mpvExe . '" --no-video --force-window=no --really-quiet --input-ipc-server=' . mp.pipe
        . ' --script="' . mp.lua . '"'
        . " --volume=" . (IsInteger(vol) ? vol : cfg.volume) . " --ytdl-raw-options=playlist-items=1"
        . " --ytdl-format=bestaudio/best --audio-format=s16 --audio-buffer=0.5 --cache=yes --cache-secs=120 --demuxer-max-bytes=100MiB"
        . (mp.af != "" ? ' "--af=' . mp.af . '"' : "")
        . ' "' . (f != "" ? f : Resolve(url)) . '"'
    mp.t0 := A_TickCount
    mp.loading := true
    try {
        Run(cmd, , "Hide", &pid)
    } catch {
        MpvLog("Run failed: " . cmd)
        UiPush("mpv", "fail")
        return
    }
    mp.pid := pid
    MpvLog("play pid " . pid . (f != "" ? " from cache " . f : " streaming " . url))
    try ProcessSetPriority("AboveNormal", pid)      ; the busy lyrics page must not starve the audio
    ; Windows throttles background processes (power saving + coarse timers); opt mpv out so the audio does not stutter when this window is not focused
    if h := DllCall("OpenProcess", "UInt", 0x200, "Int", 0, "UInt", pid, "Ptr") {      ; PROCESS_SET_INFORMATION
        st := Buffer(12, 0)
        NumPut("UInt", 1, st, 0)                      ; PROCESS_POWER_THROTTLING_CURRENT_VERSION
        NumPut("UInt", 5, st, 4)                      ; ControlMask = EXECUTION_SPEED | IGNORE_TIMER_RESOLUTION, StateMask 0 = throttling off
        DllCall("SetProcessInformation", "Ptr", h, "Int", 4, "Ptr", st, "UInt", 12)
        DllCall("CloseHandle", "Ptr", h)
    }
    MpvJob(pid)
    SetTimer(MpvWatch, 250)
}

; The first hit of a YouTube Music search is often a live / cover / remix / other song. YouTube Music results carry no length, so the same
; words are searched on regular YouTube (its results do) and the video whose length is within 3 s of the real song wins (the url carries it as
; &d=seconds); an auto-generated "Artist - Topic" upload wins over a normal video. Any failure or no match returns the url unchanged = the old "first hit".
; shortcut: blocks the script 2-4 s once per song (remembered after), only length + "Topic" are compared; make it async if that freeze is noticed
Resolve(url) {
    static memo := Map()
    if memo.Has(url)
        return memo[url]
    if ytdlpExe = "" || !RegExMatch(url, "\?q=([^&#]+)&d=(\d+)#songs$", &m)
        return url
    tmp := A_Temp . "\gamdl_resolve_" . A_TickCount . ".txt"      ; own file: the script can be interrupted here by a click that resolves the same song
    try RunWait(A_ComSpec . ' /c ""' . ytdlpExe . '" --flat-playlist --playlist-items 1-15 --no-warnings --socket-timeout 10 --print "%(id)s|%(duration)s|%(channel)s" "https://www.youtube.com/results?search_query=' . m[1] . '" >"' . tmp . '" 2>nul"', , "Hide")
    out := "", best := url, top := 99
    try out := FileRead(tmp)
    try FileDelete(tmp)
    loop parse out, "`n", "`r" {
        if !RegExMatch(A_LoopField, "^([\w-]{11})\|(\d+(?:\.\d+)?)\|(.*)$", &r) || Abs(r[2] - m[2]) > 3
            continue
        score := Abs(r[2] - m[2]) + (r[3] ~= " - Topic$" ? 0 : 4)
        if score < top
            top := score, best := "https://music.youtube.com/watch?v=" . r[1]
    }
    note := ""
    if best = url
        note := "  NO MATCH, raw: " . SubStr(StrReplace(out, "`n", " | "), 1, 300)
    MpvLog("resolve " . m[1] . " d=" . m[2] . " -> " . best . note)
    if out != ""                                    ; a failed run (no output) is not remembered, the next play tries again
        memo[url] := best
    return best
}

; ProcessExist can keep reporting a process that already ended (some handle to it is still open), so ask Windows for the exit code instead
PidAlive(pid) {
    if !pid
        return false
    h := DllCall("OpenProcess", "UInt", 0x1000, "Int", 0, "UInt", pid, "Ptr")      ; PROCESS_QUERY_LIMITED_INFORMATION
    if !h
        return false
    DllCall("GetExitCodeProcess", "Ptr", h, "UInt*", &code := 0)
    DllCall("CloseHandle", "Ptr", h)
    return code = 259                                                              ; STILL_ACTIVE
}

; one line per mpv event in gamdl_mpv.log (next to the script), to see where "next song" stops
MpvLog(s) {
    try FileAppend(FormatTime(, "HH:mm:ss") . "  " . s . "`n", A_ScriptDir . "\gamdl_mpv.log", "UTF-8")
}

MpvStop() {
    pid := mp.pid
    mp.pid := 0                                  ; so MpvWatch does not report this kill as a song ending
    if pid
        try ProcessClose(pid)
}

; ---- songs are saved to cacheDir by yt-dlp (through aria2c when it is installed): the next song while this one plays, and every song once it plays, so playing one again starts from disk ----
MpvPre(url) {
    if ytdlpExe = "" || !RegExMatch(url, '^https://music\.youtube\.com/search\?q=[^"\s]+#songs$')      ; same trust check as MpvPlay
        return
    pf.nxt := url
    SetTimer(PfPump, 1000)
}

; saves pf.nxt and pf.cur one at a time (nxt first: skipping to it is far more likely than replaying cur, and an uncached start takes 5-7 s); runs every second until both are on disk
PfPump() {
    global aria2Exe
    if PfBusy() {
        if pf.url != pf.cur && pf.url != pf.nxt
            PfKill()                               ; the user moved on: stop saving a song nobody waits for
        return
    }
    if pf.url != "" && PfReady(pf.url) = ""
        pf.bad[pf.url] := 1                        ; it ended without a file: do not try it again
    pf.url := "", pf.pid := 0
    if mp.loading && mp.pid
        return                                     ; mpv gets the network until its song plays
    for url in [pf.nxt, pf.cur] {
        if url = "" || pf.bad.Has(url) || PfReady(url) != ""
            continue
        if aria2Exe = ""
            aria2Exe := FindAria2()
        cmd := '"' . ytdlpExe . '" -f bestaudio/best --playlist-items 1 --no-mtime --no-warnings -o "' . cacheDir . '\' . UrlTag(url) . '.%(ext)s"'      ; --no-mtime: PfTrim goes by file time
        if aria2Exe != ""
            cmd .= ' --downloader "' . aria2Exe . '" --downloader-args "aria2c:-x 8 -s 8 -k 1M"'
        try {
            Run(cmd . ' "' . Resolve(url) . '"', , "Hide", &pid)
        } catch {
            pf.bad[url] := 1
            return
        }
        pf.url := url, pf.pid := pid
        MpvJob(pid)                                ; closes with this script, like mpv
        return
    }
    SetTimer(PfPump, 0)
    PfTrim()
}

PfBusy() {
    return PidAlive(pf.pid)
}

; file name of a song in cacheDir: a hash of its search url (FNV-1a)
UrlTag(url) {
    h := 2166136261
    loop parse url
        h := ((h ^ Ord(A_LoopField)) * 16777619) & 0xFFFFFFFF
    return Format("{:08x}", h)
}

; path of the finished file for this song, or "" (not saved yet, still being saved, or failed)
PfReady(url) {
    if pf.url = url && PfBusy()
        return ""
    loop files cacheDir . "\" . UrlTag(url) . ".*" {
        if !RegExMatch(A_LoopFileName, "i)\.(part|ytdl|aria2)$")
            return A_LoopFileFullPath
    }
    return ""
}

PfKill() {
    if PfBusy()
        try Run(A_ComSpec . " /c taskkill /PID " . pf.pid . " /T /F", , "Hide")
    pf.url := "", pf.pid := 0
}

; keeps the 40 most recently used files (about 200 MB)
; shortcut: counts files, not bytes; switch to a size limit if songs are long
PfTrim() {
    list := ""
    loop files cacheDir . "\*.*"
        list .= A_LoopFileTimeModified . "|" . A_LoopFileFullPath . "`n"
    n := 0
    loop parse Sort(RTrim(list, "`n"), "R"), "`n"      ; newest first
        if ++n > 40
            try FileDelete(SubStr(A_LoopField, 16))      ; 14 digits + "|"
}

; tells the page when the song ended; dying within a few seconds means yt-dlp or mpv failed
MpvWatch() {
    if PidAlive(mp.pid) {
        if mp.loading && (FileExist(mp.flag) || A_TickCount - mp.t0 > 30000) {      ; 30 s: stop "loading" even if the flag never comes
            mp.loading := false
            MpvLog("playing after " . (A_TickCount - mp.t0) . " ms")
            UiPush("mpv", "playing")
        }
        if !mp.loading && FileExist(mp.pos) {
            try {
                v := FileRead(mp.pos)
                if IsNumber(v) && v != mp.last {      ; only fresh positions: the page works out the delay from them
                    mp.last := v
                    UiPush("mpvt", v)
                }
            }
        }
        return
    }
    SetTimer(MpvWatch, 0)
    if !mp.pid
        return
    mp.pid := 0
    k := (A_TickCount - mp.t0 < 4000) ? "fail" : "end"
    MpvLog("mpv exited after " . (A_TickCount - mp.t0) . " ms -> " . k)
    UiPush("mpv", k)
}

; mpv goes into a job that Windows closes with this script, so the music stops even when the script is killed or hangs
MpvJob(pid) {
    static job := 0
    if !job {
        job := DllCall("CreateJobObject", "Ptr", 0, "Ptr", 0, "Ptr")
        info := Buffer(A_PtrSize = 8 ? 144 : 112, 0)            ; JOBOBJECT_EXTENDED_LIMIT_INFORMATION
        NumPut("UInt", 0x2000, info, 16)                         ; LimitFlags = KILL_ON_JOB_CLOSE
        DllCall("SetInformationJobObject", "Ptr", job, "Int", 9, "Ptr", info, "UInt", info.Size)
    }
    if h := DllCall("OpenProcess", "UInt", 0x101, "Int", 0, "UInt", pid, "Ptr") {      ; SET_QUOTA | TERMINATE
        DllCall("AssignProcessToJobObject", "Ptr", job, "Ptr", h)
        DllCall("CloseHandle", "Ptr", h)
    }
}

; the page's equalizer + enhancer as an ffmpeg filter chain ("lavfi=[...]", or "" for none): set on the playing song and kept for the next one
MpvEq(af) {
    if af = mp.af || !RegExMatch(af, "^[\w=:,.\[\]+\-]*$")      ; trust boundary: it goes into mpv's command line
        return
    mp.af := af
    MpvCmd('["set_property","af",' . JsStr(af) . ']')
}

; one JSON command to mpv's IPC pipe
MpvCmd(json) {
    if !mp.pid
        return
    ; overlapped write that gives up after 300 ms: a plain FileAppend to the pipe can freeze the whole script
    msg := '{"command":' . json . '}`n'
    n := StrPut(msg, "UTF-8") - 1
    buf := Buffer(n)
    StrPut(msg, buf, "UTF-8")
    h := DllCall("CreateFileW", "Str", mp.pipe, "UInt", 0x40000000, "UInt", 0, "Ptr", 0, "UInt", 3, "UInt", 0x40000000, "Ptr", 0, "Ptr")   ; GENERIC_WRITE, OPEN_EXISTING, FILE_FLAG_OVERLAPPED
    if h = -1
        return
    ev := DllCall("CreateEventW", "Ptr", 0, "Int", 1, "Int", 0, "Ptr", 0, "Ptr")
    ov := Buffer(A_PtrSize * 3 + 8, 0)
    NumPut("Ptr", ev, ov, A_PtrSize * 2 + 8)
    if !DllCall("WriteFile", "Ptr", h, "Ptr", buf, "UInt", n, "Ptr", 0, "Ptr", ov) && A_LastError = 997 {   ; ERROR_IO_PENDING
        if DllCall("WaitForSingleObject", "Ptr", ev, "UInt", 300) != 0
            DllCall("CancelIoEx", "Ptr", h, "Ptr", ov)
    }
    DllCall("CloseHandle", "Ptr", ev)
    DllCall("CloseHandle", "Ptr", h)
}


; ======================================================================
;   pasted links
; ======================================================================

; returns the message to show
AddLink(url) {
    url := Trim(url)
    if !RegExMatch(url, "i)^https?://(?:classical\.)?music\.apple\.com/")
        return "That doesn't look like an Apple Music link"
    kind := "link"
    nm := SlugName(url)
    artist := ""
    art := ""
    id := ""
    if RegExMatch(url, "[?&]i=(\d+)", &m)
        id := m[1]
    else if RegExMatch(url, "/(\d{6,})(?:[/?#]|$)", &m)
        id := m[1]
    if id != "" {
        body := HttpGet("https://itunes.apple.com/lookup?id=" . id . "&country=" . cfg.country)
        if RegExMatch(body, "\{[^{}]*\}", &o) {
            obj := o[0]
            found := JVal(obj, "trackName")
            kind2 := "song"
            if found = "" {
                found := JVal(obj, "collectionName")
                kind2 := "album"
            }
            if found = "" {
                found := JVal(obj, "artistName")
                kind2 := "artist"
            }
            if found != "" {
                kind := kind2
                nm := found
                artist := (kind2 = "artist") ? "" : JVal(obj, "artistName")
                art := Art300(JVal(obj, "artworkUrl100"))
            }
        }
    }
    if !QueueAdd(kind, nm, artist, url, art)
        return "Already in the queue: " . nm
    return "Added to the queue: " . nm
}

SlugName(url) {
    if RegExMatch(url, "/(?:album|playlist|artist|song|music-video|station)/([^/?#]+)", &m)
        return StrTitle(StrReplace(m[1], "-", " "))
    return url
}


; ======================================================================
;   history
; ======================================================================

LoadHistory() {
    if !FileExist(histFile)
        return
    for line in StrSplit(FileRead(histFile, "UTF-8"), "`n", "`r") {
        if line = ""
            continue
        f := StrSplit(line, "`t")
        if f.Length < 7
            continue
        app.hist.Push(Map("when", f[1], "kind", f[2], "name", f[3], "artist", f[4], "url", f[5], "art", f[6], "status", f[7]))
    }
}

AddHistory(q, status) {
    h := Map("when", FormatTime(, "yyyy-MM-dd HH:mm"), "kind", q["kind"], "name", Tidy(q["name"]), "artist", Tidy(q["artist"]), "url", q["url"], "art", q["art"], "status", status)
    app.hist.Push(h)
    line := h["when"] . "`t" . h["kind"] . "`t" . h["name"] . "`t" . h["artist"] . "`t" . h["url"] . "`t" . h["art"] . "`t" . status . "`n"
    try FileAppend(line, histFile, "UTF-8")
    SetTimer(PushHist, -200)
}

Tidy(s) {
    return StrReplace(StrReplace(s, "`t", " "), "`n", " ")
}


; ======================================================================
;   search history (most recent first, max 30)
; ======================================================================

LoadSearches() {
    if !FileExist(shFile)
        return
    for line in StrSplit(FileRead(shFile, "UTF-8"), "`n", "`r") {
        if line != "" && app.sh.Length < 30
            app.sh.Push(line)
    }
}

SaveSearches() {
    text := ""
    for q in app.sh
        text .= q . "`n"
    try FileDelete(shFile)
    try FileAppend(text, shFile, "UTF-8")
}

PushSearches() {
    UiPush("sh", Json(app.sh))
}

SearchAdd(q) {
    q := Trim(Tidy(q))
    if q = ""
        return
    i := app.sh.Length
    while i >= 1 {
        if app.sh[i] = q
            app.sh.RemoveAt(i)
        i -= 1
    }
    app.sh.InsertAt(1, q)
    while app.sh.Length > 30
        app.sh.Pop()
    SaveSearches()
    PushSearches()
}

SearchDel(q) {
    i := app.sh.Length
    while i >= 1 {
        if app.sh[i] = q
            app.sh.RemoveAt(i)
        i -= 1
    }
    SaveSearches()
    PushSearches()
}


; ======================================================================
;   favorite artists
; ======================================================================

LoadFavs() {
    if !FileExist(favFile)
        return
    for line in StrSplit(FileRead(favFile, "UTF-8"), "`n", "`r") {
        if line = ""
            continue
        f := StrSplit(line, "`t")
        if f.Length < 3
            continue
        app.favs.Push(Map("id", f[1], "name", f[2], "seen", f[3], "art", (f.Length >= 4) ? f[4] : ""))
    }
}

SaveFavs() {
    text := ""
    for f in app.favs
        text .= f["id"] . "`t" . Tidy(f["name"]) . "`t" . f["seen"] . "`t" . f["art"] . "`n"
    try FileDelete(favFile)
    try FileAppend(text, favFile, "UTF-8")
}

FavSet(id, name, seen, art) {
    if id = ""
        return
    for f in app.favs {
        if f["id"] = id {
            f["name"] := name
            f["seen"] := seen
            if art != ""
                f["art"] := art
            SaveFavs()
            PushFavs()
            return
        }
    }
    app.favs.Push(Map("id", id, "name", name, "seen", seen, "art", art))
    SaveFavs()
    PushFavs()
}

FavDel(id) {
    i := app.favs.Length
    while i >= 1 {
        if app.favs[i]["id"] = id
            app.favs.RemoveAt(i)
        i -= 1
    }
    SaveFavs()
    PushFavs()
}


; ======================================================================
;   web helpers  (iTunes results are flat JSON objects, read with regex)
; ======================================================================

; ---- non-blocking http for the UI: start now, collect the answer from a timer ----
HttpStart(id, url) {
    try {
        r := ComObject("WinHttp.WinHttpRequest.5.1")
        r.SetTimeouts(5000, 5000, 8000, 12000)
        r.Open("GET", url, true)
        if InStr(url, "https://apic-desktop.musixmatch.com/") = 1 {   ; the Musixmatch desktop API refuses requests without these two
            r.SetRequestHeader("authority", "apic-desktop.musixmatch.com")
            r.SetRequestHeader("cookie", "AWSELBCORS=0; AWSELB=0")
        }
        r.Send()
        app.httpq.Push(Map("id", id, "r", r, "t", A_TickCount))
        SetTimer(HttpPoll, 30)
    } catch {
        try wv.ExecuteScriptAsync("window.onHttp(" . JsStr(id) . "," . JsStr("") . ")")
    }
}

HttpPoll() {
    q := app.httpq
    if q.Length = 0 {
        SetTimer(HttpPoll, 0)
        return
    }
    i := q.Length
    while i >= 1 {
        it := q[i]
        done := false
        body := ""
        try {
            if it["r"].WaitForResponse(0) {
                done := true
                if it["r"].Status = 200
                    body := it["r"].ResponseText
            }
        } catch {
            done := true
        }
        if !done && A_TickCount - it["t"] > 20000
            done := true
        if done {
            q.RemoveAt(i)
            try wv.ExecuteScriptAsync("window.onHttp(" . JsStr(it["id"]) . "," . JsStr(body) . ")")
        }
        i -= 1
    }
}

HttpGet(url) {
    try {
        http := ComObject("WinHttp.WinHttpRequest.5.1")
        http.SetTimeouts(6000, 6000, 15000, 20000)
        http.Open("GET", url, false)
        http.Send()
        if http.Status != 200
            return ""
        return http.ResponseText
    } catch {
        return ""
    }
}

; track name + store link of every song object in a lookup result
ParseTracks(body) {
    out := []
    pos := 1
    while pos := RegExMatch(body, "\{[^{}]*\}", &m, pos) {
        obj := m[0]
        pos += m.Len
        nm := JVal(obj, "trackName")
        tu := JVal(obj, "trackViewUrl")
        if nm != "" && tu != ""
            out.Push(Map("name", nm, "url", tu))
    }
    return out
}

Art300(url) {
    return StrReplace(url, "100x100bb", "300x300bb")
}

; reads one "key":"text" pair out of a flat JSON object
JVal(obj, key) {
    if RegExMatch(obj, '"' . key . '"\s*:\s*"((?:[^"\\]|\\.)*)"', &m)
        return Unescape(m[1])
    return ""
}

Unescape(s) {
    q := Chr(34)
    s := StrReplace(s, "\/", "/")
    s := StrReplace(s, "\" . q, q)
    s := StrReplace(s, "\\", "\")
    while RegExMatch(s, "\\u([0-9a-fA-F]{4})", &m)
        s := StrReplace(s, m[0], Chr(Integer("0x" . m[1])), , , 1)
    return s
}

; last meaningful line of the gamdl log (gamdl uses \r for progress)
LastLine(text) {
    last := ""
    for line in StrSplit(StrReplace(text, "`r", "`n"), "`n") {
        line := Trim(line)
        if line != "" && !InStr(line, "##EXIT")
            last := line
    }
    return last
}


